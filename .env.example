# Copier ce fichier en `.env` puis remplir les valeurs.
# Ne jamais mettre le vrai `.env` dans le dépôt.

# Base de données MySQL
DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/dia

# Secret pour signer les cookies de session
JWT_SECRET=

# Connexion (OAuth Manus)
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# IA (API Forge / LLM) — sera remplacée par Claude à l'étape 1
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Port du serveur (facultatif)
PORT=3000
